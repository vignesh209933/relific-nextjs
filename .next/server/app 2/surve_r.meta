{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/surve_r/layout,_N_T_/surve_r/page,_N_T_/surve_r"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/surve_r/__PAGE__",
    "/surve_r",
    "/_index",
    "/_head"
  ]
}