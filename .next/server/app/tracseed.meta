{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/tracseed/layout,_N_T_/tracseed/page,_N_T_/tracseed"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/tracseed/__PAGE__",
    "/tracseed",
    "/_index",
    "/_head"
  ]
}